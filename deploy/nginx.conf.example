# Example only. Not installed into the running OpenResty configuration.
# Fill APP_ORIGINS with the exact browser origin before login through this host.
server {
    listen 127.0.0.1:8088;
    server_name localhost;
    root /opt/projects/travel-journal/frontend/dist;
    index index.html;
    # 20 MiB image plus multipart envelope; JSON API still enforces 128 KiB.
    client_max_body_size 21m;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location = /health {
        proxy_pass http://127.0.0.1:3080;
    }
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options nosniff;
    }
}
