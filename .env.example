# Server-side only. Never expose these values through public frontend variables.
SIYUAN_BASE_URL=http://127.0.0.1:6806
SIYUAN_API_TOKEN=
SIYUAN_NOTEBOOK_ID=
SIYUAN_ROOT_DOCUMENT_ID=
# Existing MySQL service. Use a dedicated database and account.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=travel_journal
MYSQL_USER=
MYSQL_PASSWORD=
# Website backend and browser origin (comma-separated exact origins)
API_HOST=127.0.0.1
API_PORT=3080
APP_ORIGINS=http://127.0.0.1:5178,http://localhost:5178,http://127.0.0.1:5179,http://localhost:5179
COOKIE_SECURE=false
# Initialized with npm run user:init. Never reuse the MySQL password.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
# Private originals and derived images. Keep outside public static roots.
MEDIA_ROOT=data/media
MEDIA_QUOTA_BYTES=1073741824
UPLOAD_MAX_BYTES=20971520
# JS Key is returned only at runtime for the browser SDK; secrets stay server-side.
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
AMAP_WEB_SERVICE_KEY=
# Optional future AI integration
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional local regional BRouter. Install Java 17+, then npm run routing:setup.
# Start npm run routing:serve before enabling this; API endpoint is fixed to loopback.
BROUTER_ENABLED=false
BROUTER_MANIFEST=data/brouter/manifest.json
# Stable independent signing secret for share links: 32 random bytes as 64 lowercase hex.
# Generate locally; never commit the actual value. Rotation invalidates old links.
SHARE_LINK_SECRET=
