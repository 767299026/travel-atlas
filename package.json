{
  "name": "travel-journal",
  "private": true,
  "type": "module",
  "workspaces": ["backend", "frontend"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "dev:api": "npm run dev --workspace @travel-atlas/backend",
    "dev:web": "npm run dev --workspace @travel-atlas/frontend",
    "build": "npm run build --workspace @travel-atlas/backend && npm run build --workspace @travel-atlas/frontend",
    "typecheck": "npm run typecheck --workspace @travel-atlas/backend && npm run typecheck --workspace @travel-atlas/frontend",
    "test": "npm run test --workspace @travel-atlas/backend",
    "test:browser": "tsx scripts/browser-check.ts",
    "db:generate": "drizzle-kit generate --config backend/drizzle.config.ts",
    "db:migrate": "tsx backend/src/cli/migrate.ts",
    "user:init": "tsx backend/src/cli/user-init.ts",
    "start:api": "node dist/backend/src/server.js",
    "preview": "npm run preview --workspace @travel-atlas/frontend"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
