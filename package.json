{
  "name": "travel-journal",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "admin"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "dev:api": "npm run dev --workspace @travel-atlas/backend",
    "dev:web": "npm run dev --workspace @travel-atlas/frontend",
    "build": "npm run build --workspace @travel-atlas/backend && npm run build --workspace @travel-atlas/frontend && npm run build --workspace @travel-atlas/admin",
    "typecheck": "npm run typecheck --workspace @travel-atlas/backend && npm run typecheck --workspace @travel-atlas/frontend && npm run typecheck --workspace @travel-atlas/admin",
    "test": "npm run test --workspace @travel-atlas/backend",
    "test:browser": "tsx scripts/browser-check.ts",
    "test:browser:m2": "tsx scripts/browser-m2-check.ts",
    "test:browser:m3": "tsx scripts/browser-m3-check.ts",
    "test:browser:amap": "tsx scripts/browser-amap-check.ts",
    "db:generate": "drizzle-kit generate --config backend/drizzle.config.ts",
    "db:migrate": "tsx backend/src/cli/migrate.ts",
    "db:backup": "tsx backend/src/cli/backup.ts",
    "user:init": "tsx backend/src/cli/user-init.ts",
    "start:api": "node dist/backend/src/server.js",
    "preview": "node scripts/preview.mjs frontend",
    "dev:admin": "npm run dev --workspace @travel-atlas/admin",
    "preview:admin": "node scripts/preview.mjs admin",
    "media:cleanup": "tsx backend/src/cli/media-cleanup.ts",
    "routing:setup": "python3 scripts/brouter-setup.py",
    "routing:serve": "node scripts/brouter-serve.mjs",
    "routing:cleanup": "tsx backend/src/cli/routing-cleanup.ts",
    "test:browser:m32": "tsx scripts/browser-m32-check.ts",
    "share:cleanup": "tsx backend/src/cli/share-cleanup.ts",
    "test:browser:m41": "tsx scripts/browser-m41-check.ts",
    "atlas:setup": "tsx backend/src/cli/atlas-setup.ts",
    "test:browser:pages": "tsx scripts/browser-pages-check.ts",
    "demo": "tsx scripts/demo.ts",
    "test:browser:atlas": "tsx scripts/browser-atlas-check.ts",
    "test:browser:mobile": "tsx scripts/browser-mobile-layout-check.ts",
    "test:browser:atlas-zoom": "tsx scripts/browser-atlas-zoom-check.ts",
    "test:browser:atlas-labels": "tsx scripts/browser-atlas-label-check.ts",
    "test:browser:memories": "tsx scripts/browser-footprint-memories-check.ts",
    "test:browser:map-perf": "tsx scripts/browser-map-performance.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
